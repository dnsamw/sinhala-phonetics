{
  "name": "@dnsam/sinhala-phonetics",
  "version": "0.1.0",
  "description": "Sinhala phonetic input with word predictions — React components + headless converter",
  "author": "Dileepa Sam",
  "license": "MIT",
  "keywords": [
    "sinhala",
    "phonetics",
    "react",
    "input",
    "unicode",
    "transliteration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsamw/sinhala-phonetics.git"
  },
  "homepage": "https://dnsamw.github.io/sinhala-phonetics",
  "bugs": {
    "url": "https://github.com/dnsamw/sinhala-phonetics/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dict-core": {
      "types": "./dist/dict-core.d.ts",
      "import": "./dist/dict-core.mjs",
      "require": "./dist/dict-core.js"
    },
    "./dict-social": {
      "types": "./dist/dict-social.d.ts",
      "import": "./dist/dict-social.mjs",
      "require": "./dist/dict-social.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
